// RimeTts 配置檔（jsonr 格式：JSON ＋ // 註釋 ＋ R"詞(…)詞" 原生字串）
// 文字值用 R"詞(…)詞" 包起來的話，引號與換行都不必轉義；短值也可以照常用普通引號。
// 改完存檔、重新啟動程式即生效。

{
	// 程式寫的那份配置檔（本工具目前沒有寫入者，保留這個位置給日後記住運行期發現的事實）
	"RwCfgPath": "rimetts.Rw.jsonr",

	"FileInteractor": {
		// Lua 插件把上屏事件寫進這個檔（整份覆寫）
		"ContentFile": R"P(D:/Program Files/Rime/User_Data/rimetts_content.json)P",
		// 本端監看這個檔；它一變就去讀上面的內容檔
		"SignalFile": R"P(D:/Program Files/Rime/User_Data/rimetts_signal)P"
	},

	"SentenceSeg": {
		// 最後一次上屏後多少毫秒成句。本工具預設只靠這個間隔斷句，不按標點。
		"NoCommitGapMs": 5000,
		// 可選，預設留空（＝不啟用）：上屏以其中之一結尾就立刻成句，不等那 5 秒。
		// 要的話填例如 ["。", "！", "？", ".", "!", "?"]
		"SentenceTerminators": []
	},

	"Translator": {
		// LLM 接口密鑰；不填程式會在啟動時報錯
		"ApiKey": "",
		"BaseUrl": "https://api.deepseek.com/chat/completions",
		"Model": "deepseek-v4-flash",
		// 單次請求超時（秒）
		"TimeoutSec": 20,
		// 譯文快取條目上限；0＝不快取
		"CacheCapacity": 256,
		// 語言條目沒寫提示詞時用它
		"DefaultSystemPrompt": R"PROMPT(You are a fast translator. Translate the user's text into English.

Return jsonr only, nothing else. jsonr is JSON plus C++ style raw strings.
Pick a NEW random delimiter for the raw string in every answer. Never reuse the delimiter
shown in the example below, and never reuse the one from a previous answer.

{
	"UserInputLang": "zh",
	"TargetLang": "en",
	"Translation": R"Xk7q(Translated Text)Xk7q"
}

Rules:
- UserInputLang: the BCP-47 tag of the language you detected in the input.
- TargetLang: must be exactly "en".
- Translation: the translated text, wrapped as R"k3Xq(…)k3Xq" where k3Xq stands for an
  alphanumeric token you invent for THIS answer — make it look random (mixed letters and
  digits), and never reuse the token from the example or from a previous answer.
  The token must not occur anywhere inside the text; if it does, invent another one.
  The reader ends the value at the first occurrence of that closing token, so "the token is
  absent from the text" is exactly what lets you skip escaping quotes and newlines.
- If the text cannot be translated, write: "Translation": null
- Do not wrap the whole answer in markdown fences.)PROMPT"
	},

	"Tts": {
		// 空字串＝執行檔目錄下的 tts-output
		"OutputDir": "",
		// 全域引擎優先級：gTTS（線上，音質好）→ SystemSpeech（離線，一定有）
		"Engines": ["gTTS", "SystemSpeech"]
	},

	"LanguagePipeline": {
		// 順序即播放順序：先英、再日、再西、義、法
		"Languages": [
			{
				"Language": "en",
				"SystemPrompt": R"PROMPT(You are a fast translator. Translate the user's text into English.

