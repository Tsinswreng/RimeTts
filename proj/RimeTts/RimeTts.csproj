<Project Sdk="Microsoft.NET.Sdk">

	<!-- 業務程序集：打字監聽、成句、翻譯、語音合成與播放的實作，
		 以及跨專案共用的契約（DTO、服務接口、配置鍵、異常鍵、日誌門面）。

		 *它自己不是可執行程式*：入口在 RimeTts.Cli。這樣 Test／Scripts 才能引用它來跑用例，
		 而不必把整個宿主一起併進來。

		 *共用基礎依賴不寫這裡*：本地庫、DI、日誌套件一律在 ../Directory.Build.props；
		 本檔只留「只有這個程序集才有」的東西。 -->
	<PropertyGroup>
		<RootNamespace>RimeTts</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!-- 音頻播放（WaveOut 走 WinMM）與 WAV／MP3 讀取；只用得到這一個套件。 -->
		<PackageReference Include="NAudio" Version="2.2.1" />

		<!-- 離線 TTS：SAPI（Windows 自帶語音）。線上那條腿（gTTS）走 HttpClient，不需要套件。 -->
		<PackageReference Include="System.Speech" Version="9.0.10" />
	</ItemGroup>

</Project>
